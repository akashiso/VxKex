LIBRARY KxAdvapi
EXPORTS
	RegGetValueA				= KxBase.RegGetValueA
	RegGetValueW				= KxBase.RegGetValueW
	
	;; token.c
	OpenProcessToken			= Ext_OpenProcessToken

	;; Forwarders to KexDll
	EventSetInformation			= KexDll.KexEtwEventSetInformation

	;; Forwarders to KxBase
	CreateWellKnownSid			= KxBase.CreateWellKnownSid
	RegOpenKeyExA				= KxBase.RegOpenKeyExA
	RegOpenKeyExW				= KxBase.RegOpenKeyExW
	RegEnumKeyExA				= KxBase.RegEnumKeyExA
	RegEnumKeyExW				= KxBase.RegEnumKeyExW
	RegQueryValueExW			= KxBase.RegQueryValueExW
	GetDynamicTimeZoneInformationEffectiveYears = KxBase.GetDynamicTimeZoneInformationEffectiveYears
	EnumDynamicTimeZoneInformation = KxBase.EnumDynamicTimeZoneInformation


	;; ORIGINAL DLL
	RegOpenKeyEx				= RegOpenKeyExW